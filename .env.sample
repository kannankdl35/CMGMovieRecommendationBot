# MongoDB
# ==========================
MONGO_URI=mongodb+srv://movierecbot:cmgbot@cluster0.jprhzud.mongodb.net/?appName=Cluster0

# ==========================
# Log Channel (private group/channel for bot activity logs)
# Add the bot as admin there, then set its numeric chat id here
# (starts with -100 for channels/supergroups)
# ==========================
LOG_CHANNEL_ID=-1002587402378

# ==========================
# /stats and /broadcast commands
# ADMIN_IDS: comma-separated Telegram user ids allowed to run /stats and
#   /broadcast. Leave empty to allow ANY user to run /stats - but note
#   /broadcast always requires this to be set (empty = nobody can
#   broadcast).
# MONGO_STORAGE_LIMIT_MB: your MongoDB storage quota in MB - 512 is
#   Atlas' free tier (M0) cap.
# ==========================
ADMIN_IDS=123456789
MONGO_STORAGE_LIMIT_MB=512
